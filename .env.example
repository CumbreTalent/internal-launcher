# Copy to .env for `vercel dev`. On Vercel, add these under Settings → Environment Variables.

# The Quote Builder's PRODUCTION Supabase project — the same two values that
# project's Vercel env calls VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY.
# People sign in to the launcher with their Quote Builder email + password.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Server-only. The same project's service key. The People screen uses it,
# behind the super-admin check, to create logins and set roles.
SUPABASE_SERVICE_ROLE_KEY=

# The super admin: sees everything, and is the only one who can add, change or
# remove people. Set ONLY here; no screen can create one. Everyone else's role
# (admin or assistant) lives on their own login and is managed on People.
LAUNCHER_SUPERADMIN_EMAILS=you@offloadcrew.com

# Leave 0 until the offloadcrew.com subdomains resolve in Vercel + DNS, then set
# to 1 and redeploy: every tile switches from *.vercel.app to offloadcrew.com,
# and apps start opening inside the launcher window. To move apps one at a time,
# list the tile keys whose address already works instead, e.g. crm or crm,quotes.
LAUNCHER_USE_CUSTOM_DOMAINS=0

# Single sign-on. Make it with `node scripts/make-keys.mjs`. Secret: launcher only.
# Leave unset until every app has its /api/launch route and LAUNCHER_PUBLIC_KEY.
LAUNCHER_SIGNING_KEY=
